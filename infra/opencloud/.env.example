# Copy to .env next to compose.yml. Never commit .env.

# Image major version (production line). See README "Version".
OC_MAJOR=7

# Your user's IDs on the VM (`id -u`, `id -g`). The config and data folders must be owned by them.
PUID=1000
PGID=1000

# Public address, without https://.
OC_DOMAIN=cloud.niijimasisters.com

# Password for the "admin" user. Only used on the very first start. Change it later in the web UI
# (top right → Preferences). Keep this line filled in anyway: compose refuses to start without it.
# Make one with:  openssl rand -base64 18
INITIAL_ADMIN_PASSWORD=

# Where your files live: a folder on the extra persistent disk (README "Storage").
OC_DATA_DIR=/mnt/cloud/opencloud-data

# Leave false. Set to true only if login fails with certificate errors (README "Troubleshooting").
OC_INSECURE=false

LOG_LEVEL=info
DEFAULT_LANGUAGE=en

# Traefik (same as your other services).
TRAEFIK_NETWORK=zipline_default
TRAEFIK_ENTRYPOINT=web
