# Copy to .env next to compose.yml. Never commit .env.

# Image major version. 15 = LTS (recommended). See README "Version".
FORGEJO_MAJOR=15

# Your user's IDs on the VM (run `id -u` and `id -g`). Usually 1000.
PUID=1000
PGID=1000

# Public address.
FORGEJO_HOST=git.niijimasisters.com

# Optional SSH via Cloudflare Access (README "Git over SSH"). Set FORGEJO_DISABLE_SSH=true
# if you only use HTTPS, so Forgejo stops showing SSH clone URLs.
FORGEJO_SSH_HOST=ssh-git.niijimasisters.com
FORGEJO_DISABLE_SSH=false

# true = visitors must sign in to see anything (even public repos).
FORGEJO_REQUIRE_SIGNIN_VIEW=false

# How often pull mirrors re-fetch from GitHub by default (per-repo setting overrides this).
FORGEJO_MIRROR_INTERVAL=8h

# Forgejo Actions (CI). Leave false unless you run a runner (README "Actions runner").
FORGEJO_ACTIONS=false

# Traefik (same as your other services).
TRAEFIK_NETWORK=zipline_default
TRAEFIK_ENTRYPOINT=web

# Used by backup.sh: a folder on your rclone Google Drive mount, and how many dumps to keep.
BACKUP_DEST=/mnt/backups/forgejo
BACKUP_KEEP=14
